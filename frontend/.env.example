# Backend origin.
# Leave unset locally: REST calls then go to /api and Next's rewrite proxies them
# to http://localhost:5000, which keeps the auth cookie first-party.
# REQUIRED in any deployed environment (e.g. https://api.your-domain.com).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Socket.io origin. Falls back to NEXT_PUBLIC_API_URL, then to http://localhost:5000.
# This must point at the Express server directly — the Next rewrite proxy drops
# the auth cookie during the WebSocket upgrade.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
